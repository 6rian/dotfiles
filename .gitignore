# Generated by xeno.nvim's xeno.theme() call every Neovim startup
# (nvim/lua/plugins/ui/colorschemes/xeno.lua) -- a build artifact, not
# source. Regenerated fresh before every :colorscheme load regardless of
# what's on disk, so it never needs to be committed; tracking it only
# produced spurious diffs from Lua's non-deterministic table iteration
# order on each write.
nvim/colors/xeno-*.lua

# Personal WorkerBee data belongs in ~/working (real per-host dirs), never
# in this repo -- backstop in case something writes through a symlink.
working/ai/lessons/
working/ai/memory/
working/ai/.state/
