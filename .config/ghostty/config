## vim:fileencoding=utf-8

# ghostty +list-themes to see all available themes
theme = "catppuccin-cyberpunk"

# ghostty +list-fonts to see all available fonts
#font-family = "Hack Nerd Font"
#font-family = "Noto Mono Nerd Font Mono"
font-family = "BitstromWera Nerd Font Mono"
font-size = 13

background = "#000000"
background-opacity = 0.85
background-blur-radius = 20

cursor-style = "underline"

macos-titlebar-style = "tabs"
macos-option-as-alt = true

macos-icon = "custom-style"
macos-icon-frame = "beige"
macos-icon-ghost-color = "#4E00A1"
macos-icon-screen-color = "#1D003D"

# xeno.nvim theme colors
background = 090020
foreground = bcc1bf
cursor-color = 6c25ff
# End xeno.nvim theme colors
