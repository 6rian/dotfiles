{
  "model": "opus",
  "tui": "fullscreen",
  "theme": "custom:xeno-cyberpunk-v2",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "cleanupPeriodDays": 365,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": true,
  "preferredNotifChannel": "ghostty",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "workmux register-agent"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v afplay >/dev/null && afplay /System/Library/Sounds/Glass.aiff || true"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\"; fi 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux set-window-status done"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX_PANE\" ]; then printf '\\a' > \"$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}')\"; fi 2>/dev/null; true"
          }
        ]
      }
    ]
  }
}
