{
  "model": "opus",
  "enabledPlugins": {
    "nhumphrey@fandom-plugins": true
  },
  "permissions": {
    "allow": [
      "mcp__fandom-knowledgebase"
    ]
  },
  "tui": "fullscreen",
  "theme": "custom:xeno-cyberpunk-v2",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/working/ai/hooks/workerbee-hook.sh && bash ~/working/ai/hooks/workerbee-hook.sh session-start || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/working/ai/hooks/workerbee-hook.sh && bash ~/working/ai/hooks/workerbee-hook.sh prompt || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/working/ai/hooks/workerbee-hook.sh && bash ~/working/ai/hooks/workerbee-hook.sh pre-compact || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/working/ai/hooks/workerbee-hook.sh && bash ~/working/ai/hooks/workerbee-hook.sh session-end || true"
          }
        ]
      }
    ]
  }
}
